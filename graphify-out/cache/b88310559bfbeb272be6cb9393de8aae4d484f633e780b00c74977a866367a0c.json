_nid": "route_post", "callee": "String", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L184"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L186"}, {"caller_nid": "route_post", "callee": "setTimeout", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L196"}, {"caller_nid": "route_post", "callee": "(async () => {\n      try {\n        const text = await parseDocument(file.name, buffer);\n        if (timedOut) return; // abort after timeout \u2014 don't attempt to write stale data\n        if (text && text.trim().length > 0) {\n          await indexDocument(\n            {\n              chunk_id: storagePath,\n              title: file.name,\n              content: text,\n              source_url: storagePath,\n              metadata: {\n                provider: \"direct_upload\",\n                resource_type: ext.toLowerCase(),\n                author: ownerId ?? undefined,\n              },\n            },\n            orgId,\n            connId,\n            null,        // departmentId \u2014 unrestricted within org\n            \"restricted\",\n            ownerId,\n          );\n          if (timedOut) return;\n          // Mark document as indexed in the DB\n          await supabaseAdmin\n            .from(\"documents\")\n            .update({ last_indexed_at: new Date().toISOString() })\n            .eq(\"id\", doc.id);\n          logger.info({ docId: doc.id, name: file.name }, \"[files/upload] Indexing complete\");\n        } else {\n          logger.warn({ docId: doc.id, name: file.name }, \"[files/upload] No extractable text \u2014 skipping indexing\");\n        }\n      } catch (indexErr: any) {\n        logger.error({ docId: doc.id, name: file.name, err: indexErr?.message }, \"[files/upload] Background indexing failed\");\n      } finally {\n        clearTimeout(timeoutId);\n      }\n    })", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L201"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L244"}, {"caller_nid": "route_post", "callee": "error", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L256"}, {"caller_nid": "route_post", "callee": "String", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L256"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L257"}]}