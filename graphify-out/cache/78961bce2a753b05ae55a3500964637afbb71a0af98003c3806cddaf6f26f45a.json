les/upload/route.ts", "source_location": "L139"}, {"caller_nid": "route_post", "callee": "upload", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L141"}, {"caller_nid": "route_post", "callee": "from", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L141"}, {"caller_nid": "route_post", "callee": "error", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L151"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L153"}, {"caller_nid": "route_post", "callee": "toUpperCase", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L158"}, {"caller_nid": "route_post", "callee": "toFixed", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L162"}, {"caller_nid": "route_post", "callee": "toFixed", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L163"}, {"caller_nid": "route_post", "callee": "classifyFileLayer", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L165"}, {"caller_nid": "route_post", "callee": "single", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L167"}, {"caller_nid": "route_post", "callee": "select", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L167"}, {"caller_nid": "route_post", "callee": "insert", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L167"}, {"caller_nid": "route_post", "callee": "from", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L167"}, {"caller_nid": "route_post", "callee": "error", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L185"}, {"caller_nid": "route_post", "callee": "String", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L185"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L187"}, {"caller_nid": "route_post", "callee": "setTimeout", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L197"}, {"caller_nid": "route_post", "callee": "(async () => {\n      try {\n        let indexed = false;\n\n        if (TABULAR_EXTS.has(rawExt)) {\n          // Tabular path: parse into structured rows, generate stats/sample/agg/analysis chunks\n          const tables = await parseDocumentStructured(file.name, buffer);\n          if (timedOut) return;\n          if (tables && tables.length > 0) {\n            const tabularChunks = await tabularChunksFromParsed(tables, storagePath, file.name, storagePath, {\n              withLlmAnalysis: true,\n              orgId,\n            });\n            if (timedOut) return;\n            if (tabularChunks.length > 0) {\n              await indexDocuments(tabularChunks, orgId, connId, null, \"restricted\", ownerId);\n              indexed = true;\n            }\n          }\n        }\n\n        if (!indexed) {\n          // Non-tabular path: use enhanced parser which extracts embedded tables via\n          // LlamaParse (PDF/DOCX/PPTX) and returns narrative text + structured tables.\n          const { text, tables } = await parseDocumentEnhanced(file.name, buffer);\n          if (timedOut) return;\n\n          // Index any tables embedded in the document (Hebbia-style structured extraction)\n          if (tables.length > 0) {\n            const tableChunks = await tabularChunksFromParsed(\n              tables,\n              storagePath,\n              file.name,\n              storagePath,\n              { withLlmAnalysis: true, orgId },\n            );\n            if (timedOut) return;\n            if (tableChunks.length > 0) {\n              await indexDocuments(tableChunks, orgId, connId, null, \"restricted\", ownerId);\n              indexed = true;\n            }\n          }\n\n          // Always index narrative text when present\n          if (text && text.trim().length > 0) {\n            if (timedOut) return;\n            await indexDocument(\n              {\n                chunk_id: storagePath,\n                title: file.name,\n                content: text,\n                source_url: storagePath,\n                metadata: {\n                  provider: \"direct_upload\",\n                  resource_type: ext.toLowerCase(),\n                  author: ownerId ?? undefined,\n                },\n              },\n              orgId,\n              connId,\n              null,\n              \"restricted\",\n              ownerId,\n            );\n            indexed = true;\n          }\n        }\n\n        if (timedOut) return;\n        if (indexed) {\n          await supabaseAdmin\n            .from(\"documents\")\n            .update({ last_indexed_at: new Date().toISOString() })\n            .eq(\"id\", doc.id);\n          logger.info({ docId: doc.id, name: file.name }, \"[files/upload] Indexing complete\");\n        } else {\n          logger.warn({ docId: doc.id, name: file.name }, \"[files/upload] No extractable content \u2014 skipping indexing\");\n        }\n      } catch (indexErr: any) {\n        logger.error({ docId: doc.id, name: file.name, err: indexErr?.message }, \"[files/upload] Background indexing failed\");\n      } finally {\n        clearTimeout(timeoutId);\n      }\n    })", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L202"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L289"}, {"caller_nid": "route_post", "callee": "error", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L300"}, {"caller_nid": "route_post", "callee": "String", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L300"}, {"caller_nid": "route_post", "callee": "json", "source_file": "/Users/mazza/Desktop/Work/AtheneMain/athene-app/app/api/files/upload/route.ts", "source_location": "L301"}]}